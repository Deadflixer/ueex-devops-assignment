# Скопіюйте у .env і заповніть:  cp .env.example .env && chmod 600 .env
# .env НЕ комітиться в Git. Робоча копія .env зберігається в менеджері паролів —
# без неї відновлення на новому хості неможливе (див. docs/RUNBOOK.md).

# --- Загальне ---------------------------------------------------------------
# IP-адреса або DNS-імʼя сервера; потрапляє в SAN self-signed сертифіката
SERVER_NAME=203.0.113.10

# --- Застосунок ------------------------------------------------------------
# Тег образу kanboard/kanboard. Змінюється скриптами update.sh / rollback.sh
APP_TAG=v1.2.56

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=kanboard
POSTGRES_USER=kanboard
# Тільки [A-Za-z0-9] — пароль підставляється в DATABASE_URL.
# Згенерувати: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
